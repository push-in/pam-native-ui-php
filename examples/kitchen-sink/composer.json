{
    "name": "pushinbr/pam-native-ui-kitchen-sink",
    "description": "PAM Mobile UI native component catalog.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native-ui": "0.6.x-dev",
        "pushinbr/pam-native": "^0.8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": false,
                "versions": {
                    "pushinbr/pam-native-ui": "0.6.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
